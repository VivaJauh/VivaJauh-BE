generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  field_officer
  remote_admin
}

enum SyncStatus {
  pending
  syncing
  synced
  failed
  conflict
}

enum VerificationStatus {
  unverified
  verified
  rejected
  needs_correction
}

enum LoanStatus {
  draft
  pending_review
  approved
  rejected
}

enum LoanRiskLevel {
  low
  medium
  high
}

model MsUser {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  name         String
  email        String   @unique
  role         UserRole @default(field_officer)
  koperasiName String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devices             MsDevice[]
  tenants             MsTenant[]
  records             TrSyncRecord[]
  feedTransactions    TrFeedTransaction[]
  livestockEvents     TrLivestockEvent[]
  savingsTransactions TrSavingsTransaction[]
  loanRepayments      TrLoanRepayment[]
  sellerCredits       TrSellerCredit[]
  loanApplications    TrLoanApplication[]
}

model MsTenant {
  id           String   @id @default(uuid())
  userId       String
  koperasiName String   @unique
  koperasiType String   @default("primer")
  focusArea    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user MsUser @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([koperasiName])
}

model MsDevice {
  id               String    @id @default(uuid())
  userId           String
  deviceIdentifier String
  deviceName       String?
  platform         String    @default("flutter")
  status           String    @default("active")
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user    MsUser         @relation(fields: [userId], references: [id])
  records TrSyncRecord[]

  @@unique([deviceIdentifier])
}

model TrSyncRecord {
  id                 String             @id @default(uuid())
  localId            String
  userId             String
  deviceId           String
  recordType         String
  payloadJson        Json
  syncStatus         SyncStatus         @default(synced)
  verificationStatus VerificationStatus @default(unverified)
  idempotencyKey     String
  recordedAt         DateTime
  uploadedAt         DateTime?
  errorMessage       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user   MsUser   @relation(fields: [userId], references: [id])
  device MsDevice @relation(fields: [deviceId], references: [id])

  feedTransaction    TrFeedTransaction?
  livestockEvent     TrLivestockEvent?
  savingsTransaction TrSavingsTransaction?
  loanRepayment      TrLoanRepayment?
  sellerCredit       TrSellerCredit?

  @@unique([idempotencyKey])
  @@index([recordType])
  @@index([verificationStatus])
}

model TrFeedTransaction {
  id             String   @id @default(uuid())
  recordId       String   @unique
  userId         String
  feedType       String
  direction      String   @default("masuk")
  quantityKg     Float
  adjustmentSign Int      @default(1)
  warehouse      String?
  recordedAt     DateTime
  createdAt      DateTime @default(now())

  record TrSyncRecord @relation(fields: [recordId], references: [id])
  user   MsUser       @relation(fields: [userId], references: [id])

  @@index([feedType])
}

model TrLivestockEvent {
  id            String   @id @default(uuid())
  recordId      String   @unique
  userId        String
  livestockType String
  eventType     String   @default("penambahan")
  quantity      Float
  pen           String?
  healthNote    String?
  recordedAt    DateTime
  createdAt     DateTime @default(now())

  record TrSyncRecord @relation(fields: [recordId], references: [id])
  user   MsUser       @relation(fields: [userId], references: [id])

  @@index([livestockType])
}

model TrSavingsTransaction {
  id         String   @id @default(uuid())
  recordId   String   @unique
  userId     String
  memberName String
  memberId   String?
  direction  String   @default("setor")
  amount     Float
  recordedAt DateTime
  createdAt  DateTime @default(now())

  record TrSyncRecord @relation(fields: [recordId], references: [id])
  user   MsUser       @relation(fields: [userId], references: [id])

  @@index([memberName])
}

model TrLoanRepayment {
  id         String   @id @default(uuid())
  recordId   String   @unique
  userId     String
  memberName String
  memberId   String?
  loanRef    String?
  amount     Float
  recordedAt DateTime
  createdAt  DateTime @default(now())

  record TrSyncRecord @relation(fields: [recordId], references: [id])
  user   MsUser       @relation(fields: [userId], references: [id])

  @@index([memberName])
}

model TrSellerCredit {
  id         String   @id @default(uuid())
  recordId   String   @unique
  userId     String
  sellerName String
  items      String?
  amount     Float
  recordedAt DateTime
  createdAt  DateTime @default(now())

  record TrSyncRecord @relation(fields: [recordId], references: [id])
  user   MsUser       @relation(fields: [userId], references: [id])

  @@index([sellerName])
}

model TrLoanApplication {
  id                String     @id @default(uuid())
  applicantName     String
  applicantMemberId String?
  targetKoperasi    String
  requestedAmount   Float
  purpose           String?
  tenureMonths      Int
  status            LoanStatus @default(pending_review)
  submittedBy       String
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  submitter      MsUser                @relation(fields: [submittedBy], references: [id])
  recommendation TrLoanRecommendation?

  @@index([applicantName])
  @@index([targetKoperasi])
  @@index([status])
}

model TrLoanRecommendation {
  id                String        @id @default(uuid())
  loanApplicationId String        @unique
  riskLevel         LoanRiskLevel
  recommendation    String
  summary           String
  keyStatsJson      Json
  chartDataJson     Json
  evidenceJson      Json
  modelProvider     String        @default("rule_based")
  modelRawResponse  Json?
  createdAt         DateTime      @default(now())

  loanApplication TrLoanApplication @relation(fields: [loanApplicationId], references: [id])
}

model TrAuditLog {
  id           String   @id @default(uuid())
  userId       String
  action       String
  targetType   String
  targetId     String?
  resultStatus String
  metadataJson Json?
  createdAt    DateTime @default(now())
}
